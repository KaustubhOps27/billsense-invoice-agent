    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n \n  const extractedData = $(\"Information Extractor\").item.json.output;\n  \n\n  const rate = item.json.rates.INR;\n  \n\n  const calculatedTotal = extractedData.orignal_amount * rate;\n  const calculatedGst = extractedData.gst_amount * rate;\n  \n  \n  item.json = {\n    ...extractedData,\n    exchange_rate_used: rate,\n    total_amount_inr: calculatedTotal,\n    total_gst_inr: calculatedGst\n  };\n}\n\nreturn $input.all();\n"
      },
